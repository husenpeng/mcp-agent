# Desktop package cache: the default under apps/desktop plus any absolute
# TOMATO_DESKTOP_PACKAGE_CACHE_DIR, such as the repository-root one.
.desktop-build/
python/sdk-runtime/src/deepseek_harness_runtime/runtime/
python/**/__pycache__/
python/**/.pytest_cache/
packages/**/__pycache__/
apps/web/dist/
.artifacts/
.tomato-build/
.tomato-report/
.playwright-mcp/
.orig
.worktrees/
worktrees/
.agents/worktrees/
.typert-*/
native/system/test/bin/

# Machine-local desktop packaging inputs. Committed templates end in .env.example.
apps/desktop/config/*-packaging/*.env
apps/desktop/config/*-packaging/secrets/
prototypes/*
desktop-test-logs/*

# Build emit belongs in each package's ignored lib/, never beside its sources.
packages/*/*/src/*.js
packages/*/*/src/*.js.map
packages/*/*/src/*.d.ts.map
# Same emit at any depth; hand-written ambient declarations are force-added or
# have no sibling source, and verify-commit-hygiene rejects emit beside a source.
packages/*/*/src/**/*.js
packages/*/*/src/**/*.js.map
packages/*/*/src/**/*.d.ts.map

# Local debugging residue (RULE.md).
*.log
*.tgz
scratch/
*.local.*
*.scratch.*
*.png
.scratch/*
