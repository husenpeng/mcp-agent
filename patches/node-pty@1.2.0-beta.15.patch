diff --git a/binding.gyp b/binding.gyp
index 9e8780ea67658836f53b3b26a481fbdfceffe462..42c231864889bf6395555353311e178ede69d48a 100644
--- a/binding.gyp
+++ b/binding.gyp
@@ -29,6 +29,18 @@
         },
       }, {
         'cflags': ['-O2', '-fstack-protector-strong'],
+        # Keep node-addon-api's callback wrapper and Napi::Error typeinfo private
+        # to this module. The upstream prebuilds export the wrapper as a weak
+        # symbol, which dyld/ELF coalesce with koffi's exception-free copy; a
+        # node-pty throw then escapes through a wrapper with no catch and aborts
+        # the process. Hidden visibility binds pty.node to its own catching
+        # wrapper so native failures surface as JS errors. napi_register_module_v1
+        # stays exported through NAPI_MODULE_EXPORT's default visibility.
+        'cflags_cc': ['-fvisibility=hidden', '-fvisibility-inlines-hidden'],
+        'xcode_settings': {
+          'GCC_SYMBOLS_PRIVATE_EXTERN': 'YES',
+          'GCC_INLINES_ARE_PRIVATE_EXTERN': 'YES',
+        },
       }],
     ],
   },
