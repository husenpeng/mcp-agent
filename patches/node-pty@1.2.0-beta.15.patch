@@ -24,6 +24,17 @@ if (process.env.npm_config_build_from_source === 'true') {
   process.exit(1);
 }

+// Tomato: build from source on Unix so binding.gyp's hidden-visibility flags
+// take effect. The upstream prebuilds export node-addon-api's callback wrapper
+// as a weak symbol that dyld/ELF coalesce with koffi's exception-free copy,
+// turning a node-pty throw into a process abort. Windows has no weak-symbol
+// interposition and keeps its prebuilds.
+if (process.platform !== 'win32') {
+  console.log('\x1b[33m> Rebuilding node-pty from source for the hidden-visibility patch\x1b[0m');
+  fs.rmSync(PREBUILDS_ROOT, { recursive: true, force: true });
+  process.exit(1);
+}
+
 // Check whether the correct prebuilt files exist
 console.log('\x1b[32m> Checking prebuilds...\x1b[0m');
 if (!fs.existsSync(PREBUILD_DIR)) {
