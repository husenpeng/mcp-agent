{
  "name": "@tomato/deepseek-account-platform",
  "description": "Authorize DeepSeek accounts through browser PKCE",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/credentials/deepseek-account-platform"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/deepseek-account": "workspace:*",
    "@tomato/authorization": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/deepseek-account": "workspace:*",
    "@tomato/authorization": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/host-webserver": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~",
    "zod": "4.4.3"
  }
}
