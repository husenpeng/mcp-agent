{
  "name": "@tomato/llm-deepseek-api-key",
  "description": "DeepSeek api-key provider authentication and discovery",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-deepseek-api-key"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/cordis-plugin-loader": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/cordis-plugin-loader": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@tomato/cordis-plugin-loader": {
      "optional": true
    }
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  }
}
