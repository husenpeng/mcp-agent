{
  "name": "@tomato/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Tomato Harness LLM seam (design-verification twin of @tomato/llm-deepseek)",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/attachment": "workspace:*",
    "@tomato/authorization": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/timeout": "workspace:*"
  },
  "dependencies": {
    "@tomato/branded": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/authorization": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/http-proxy": "workspace:*",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/llm-deepseek-api-key": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tomato/cordis-plugin-loader": {
      "optional": true
    }
  }
}
