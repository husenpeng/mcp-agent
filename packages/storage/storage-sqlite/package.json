{
  "name": "@tomato/storage-sqlite",
  "description": "SQLite storage backend (kv facet) for the Tomato Harness storage hub",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/storage/storage-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/storage": "workspace:*",
    "@tomato/cordis": "workspace:~"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/storage": "workspace:*",
    "@tomato/cordis": "workspace:~"
  }
}
