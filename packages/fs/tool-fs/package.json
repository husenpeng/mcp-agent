{
  "name": "@tomato/tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Tomato Harness filesystem seam (ctx.fs)",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@tomato/schemastery": "workspace:~",
    "@tomato/util-code-language": "workspace:*"
  },
  "peerDependencies": {
    "@tomato/attachment": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/fs-observation-policy": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/llm-deepseek-api-key": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/session-projection": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
}
