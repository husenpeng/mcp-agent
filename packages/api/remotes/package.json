{
  "name": "@tomato/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@tomato/deque": "workspace:*",
    "@tomato/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/scope": "workspace:*"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-preset-registry": "workspace:*",
    "@tomato/api-gateway": "workspace:*",
    "@tomato/api-job-controller": "workspace:*",
    "@tomato/api-session-controller": "workspace:*",
    "@tomato/api-settings-controller": "workspace:*",
    "@tomato/api-workspace-controller": "workspace:*",
    "@tomato/api-workspace-files": "workspace:*",
    "@tomato/client-connection": "workspace:*",
    "@tomato/client-file-upload": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/cordis-host-runner": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/file-reference": "workspace:*",
    "@tomato/goal": "workspace:*",
    "@tomato/host-plugin-inventory": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/message-feedback": "workspace:*",
    "@tomato/permission-presets": "workspace:*",
    "@tomato/schedule": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-reference": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/user-questions": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "zod": "4.4.3",
    "@tomato/command-feedback": "workspace:*",
    "@tomato/api-terminal-controller": "workspace:*",
    "@tomato/plugin-manager": "workspace:*",
    "@tomato/plugin-market": "workspace:*",
    "@tomato/client-ui-plugin-manager": "workspace:*",
    "@tomato/office-to-pdf": "workspace:*",
    "@tomato/api-account-controller": "workspace:*",
    "@tomato/deepseek-account": "workspace:*",
    "@tomato/client-product-analytics": "workspace:*"
  }
}
