{
  "name": "@tomato/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "external": [
        "@tomato/api-gateway/client"
      ],
      "inject": [
        "@tomato/api-gateway",
        "@tomato/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/branded": "workspace:*",
    "@tomato/deque": "workspace:*",
    "@tomato/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-default-model": "workspace:*",
    "@tomato/agent-preset-registry": "workspace:*",
    "@tomato/api-gateway": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/client-connection": "workspace:*",
    "@tomato/client-file-upload": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/file-reference": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/native-command": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/session-projection-cache": "workspace:*",
    "@tomato/session-query": "workspace:*",
    "@tomato/session-title": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/skill": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "@tomato/typert-registry": "workspace:*",
    "@tomato/util-time": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/util-workspace-path": "workspace:*",
    "@tomato/workspace": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tomato/session-persistence": {
      "optional": true
    },
    "@tomato/session-projection-cache": {
      "optional": true
    },
    "@tomato/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tomato/api-remote-access": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-default-model": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/agent-preset-registry": "workspace:*",
    "@tomato/api-gateway": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/client-connection": "workspace:*",
    "@tomato/client-file-upload": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/credentials": "workspace:*",
    "@tomato/file-reference": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/native-command": "workspace:*",
    "@tomato/permission-presets": "workspace:*",
    "@tomato/remote-mock": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/session-projection-cache": "workspace:*",
    "@tomato/session-query": "workspace:*",
    "@tomato/session-title": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/skill": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/storage-json": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "@tomato/typert-registry": "workspace:*",
    "@tomato/util-crypto": "workspace:*",
    "@tomato/util-time": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/util-workspace-path": "workspace:*",
    "@tomato/workspace": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@tomato/working-directory": "workspace:*"
  }
}
