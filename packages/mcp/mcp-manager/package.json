{
  "name": "@tomato/mcp-manager",
  "description": "MCP server manager: a settings-driven fleet of mcp-client instances with runtime status, restart, and probe",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mcp/mcp-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src",
    "lib/typert.host.d.ts.map"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/mcp-client": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@tomato/timeout": "workspace:*",
    "@tomato/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@tomato/credentials": "workspace:*",
    "@tomato/mcp-client": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/app-boot": "workspace:*",
    "@tomato/config-editor": "workspace:*",
    "@tomato/hmr": "workspace:*",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/cordis-plugin-timer": "workspace:~",
    "@tomato/typert-protocol": "workspace:*"
  }
}
