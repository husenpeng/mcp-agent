{
  "name": "@tomato/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/llm": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/spill": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/attachment": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/token-meter": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/ptc-runtime-node": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/spill": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/fs-local": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/sandbox-local": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/token-meter": "workspace:*",
    "@tomato/mcp-client": "workspace:*",
    "@tomato/spill-local": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/attachment-local": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-fs": "workspace:*",
    "sharp": "0.35.5",
    "@tomato/agent-loop-testkit": "workspace:*"
  }
}
