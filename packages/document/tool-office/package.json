{
  "name": "@tomato/tool-office",
  "description": "Model-facing Office tools for rendering, converting, and recalculating documents",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/document/tool-office"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/office-kit": "workspace:*",
    "@tomato/skill": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/attachment-local": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/office-kit": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/skill": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-skill": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
