{
  "name": "@tomato/account",
  "description": "Tomato account surface: sidebar launcher and settings page over the local gateway's auth_service session",
  "version": "0.2.1-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/client-locale",
        "@tomato/client-ui-renderer",
        "@tomato/client-ui-settings",
        "@tomato/client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-settings": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
