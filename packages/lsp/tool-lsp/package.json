{
  "name": "@tomato/tool-lsp",
  "description": "Model-facing lsp tool over the Tomato Harness LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/llm": "workspace:*",
    "@tomato/lsp": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tomato/util-values": "workspace:*",
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/lsp": "workspace:*",
    "@tomato/lsp-stdio": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "@tomato/tool-call-timeout-policy": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*"
  }
}
