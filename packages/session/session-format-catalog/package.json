{
  "name": "@tomato/session-format-catalog",
  "description": "Build-static first-party Session format codec and migration catalog",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-catalog"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./message-projections": {
      "types": "./lib/types/message-projections.d.ts",
      "default": "./lib/types/message-projections.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/session-format": "workspace:*",
    "@tomato/session-format-v0-to-v1": "workspace:*",
    "@tomato/session-format-v1-to-v2": "workspace:*",
    "@tomato/session-format-v2-to-v3": "workspace:*",
    "@tomato/session-format-v3-to-v4": "workspace:*",
    "@tomato/compaction-image-offload": "workspace:*"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/session": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/session": "workspace:*"
  }
}
