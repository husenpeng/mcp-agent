{
  "name": "@tomato/command-compact",
  "description": "Human-facing slash command for explicit session compaction",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/compaction/command-compact"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/commands": "workspace:*",
    "@tomato/compaction": "workspace:*",
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/compaction": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/cordis": "workspace:~"
  }
}
