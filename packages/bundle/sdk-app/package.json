{
  "name": "@tomato/sdk-app",
  "description": "The tomato SDK profile bundle: stdio JSON-RPC serving and process lifecycle over @tomato/base",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "tomato": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@tomato/cmdline": "workspace:*",
    "@tomato/sdk-jsonrpc-server": "workspace:*",
    "@tomato/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@tomato/skill-office": "workspace:*",
    "@tomato/tool-workspace-dependencies": "workspace:*",
    "@tomato/client-connection": "workspace:*",
    "@tomato/client-file-upload": "workspace:*",
    "@tomato/workspace": "workspace:*",
    "@tomato/schedule": "workspace:*",
    "@tomato/time-context": "workspace:*",
    "@tomato/tool-schedule": "workspace:*",
    "@tomato/tool-ask-user": "workspace:*",
    "@tomato/tool-present": "workspace:*",
    "@tomato/file-reference-local": "workspace:*",
    "@tomato/deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/cordis": "workspace:~"
  }
}
