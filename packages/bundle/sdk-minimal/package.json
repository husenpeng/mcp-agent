{
  "name": "@tomato/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "tomato": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@tomato/cordis-plugin-timer": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/attachment-local": "workspace:*",
    "@tomato/compaction-basic": "workspace:*",
    "@tomato/compaction-image-offload": "workspace:*",
    "@tomato/deepseek-llm-api-extensions": "workspace:*",
    "@tomato/jobs-local": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek-api-key": "workspace:*",
    "@tomato/llm-retry": "workspace:*",
    "@tomato/mcp-resources": "workspace:*",
    "@tomato/plugin-package-inventory-deepseek": "workspace:*",
    "@tomato/sandbox-local": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/sdk-app": "workspace:*",
    "@tomato/sdk-jsonrpc-server": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-checkpoint-policy": "workspace:*",
    "@tomato/session-log-deepseek": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/session-title": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/terminal": "workspace:*",
    "@tomato/terminal-bash": "workspace:*",
    "@tomato/token-meter": "workspace:*",
    "@tomato/tool-bash-persistent": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-fs": "workspace:*",
    "@tomato/tool-pwsh-persistent": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*",
    "@tomato/tool-working-directory": "workspace:*",
    "@tomato/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~"
  }
}
