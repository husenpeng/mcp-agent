{
  "name": "@tomato/acp",
  "description": "Automation-only Agent Client Protocol server for driving Tomato Harness agents over JSON-RPC stdio",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@tomato/branded": "workspace:*",
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/mcp-client": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence": "workspace:*",
    "@tomato/token-meter": "workspace:*",
    "@tomato/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tomato/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/mcp-client": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/token-meter": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/user-approval": "workspace:*"
  }
}
