{
  "name": "@tomato/tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/jobs-local": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~"
  }
}
