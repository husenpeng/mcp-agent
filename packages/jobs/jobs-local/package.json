{
  "name": "@tomato/jobs-local",
  "description": "Process-local implementation of the Tomato Harness background job registry seam",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "@tomato/cordis": "workspace:~"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "@tomato/cordis": "workspace:~"
  }
}
