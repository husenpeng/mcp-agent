{
  "name": "@tomato/jobs",
  "description": "Background job registry (ctx.jobs) for the Tomato Harness — shared ids, owner isolation, polling, cancellation, and completion listeners for long-running tool work",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/jobs/jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./view": {
      "types": "./lib/types/view.d.ts",
      "default": "./lib/types/view.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/workspace": "workspace:*",
    "@tomato/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@tomato/workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/workspace": "workspace:*",
    "@tomato/cordis": "workspace:~"
  }
}
