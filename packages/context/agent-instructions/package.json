{
  "name": "@tomato/agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/home-paths": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tomato/util-values": "workspace:*",
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/home-paths": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/llm-deepseek-api-key": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-fs": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
}
