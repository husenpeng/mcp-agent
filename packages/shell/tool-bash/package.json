{
  "name": "@tomato/tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/shell": "workspace:*",
    "@tomato/shell-env": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/shell": "workspace:*",
    "@tomato/shell-env": "workspace:*",
    "@tomato/bash-local": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/jobs-local": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-jobs": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/session-projection": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
}
