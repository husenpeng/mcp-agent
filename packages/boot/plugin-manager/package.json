{
  "name": "@tomato/plugin-manager",
  "description": "Current-profile plugin and bundle management shared by tomato CLI, Web and agent tools",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/tools/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/app-boot": "workspace:*",
    "@tomato/atomic-write": "workspace:*",
    "@tomato/official-bundles": "workspace:*",
    "@tomato/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "4.4.3",
    "@tomato/util-values": "workspace:*",
    "@tomato/plugin-detail": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "hosted-git-info": "^9.0.3"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/host-plugin-inventory": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/hmr": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tomato/hmr": {
      "optional": true
    },
    "@tomato/user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@tomato/package-manifest": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/host-plugin-inventory": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/hmr": "workspace:*",
    "@tomato/cordis-plugin-timer": "workspace:~",
    "@tomato/branded": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/agent": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/client-connection": "workspace:*",
    "@types/hosted-git-info": "^3.0.5"
  }
}
