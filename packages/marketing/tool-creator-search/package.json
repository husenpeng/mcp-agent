{
  "name": "@tomato/tool-creator-search",
  "description": "Model-facing creator search tools (creator_search, creator_detail, youtube_channel) over the company BFF's /api/v1/creator-search endpoints, authenticated by the Desktop session cookie",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/marketing/tool-creator-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/tools": "workspace:*"
  },
  "dependencies": {
    "@tomato/output-retention": "workspace:*",
    "@tomato/schemastery": "workspace:~",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/web": "workspace:*"
  }
}
