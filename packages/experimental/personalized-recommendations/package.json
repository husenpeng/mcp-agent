{
  "name": "@tomato/personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.1-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/action-cards": "workspace:*",
    "@tomato/client-ui-action-cards": "workspace:*",
    "@tomato/creation-recommendations": "workspace:*",
    "@tomato/client-ui-creation-recommendations": "workspace:*",
    "@tomato/plugin-recommendations": "workspace:*",
    "@tomato/client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@tomato/cordis-plugin-timer": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/api-remote-access": "workspace:*",
    "@tomato/app-boot": "workspace:*",
    "@tomato/hmr": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/plugin-manager": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/skill": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tools": "workspace:*"
  },
  "tomato": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
