{
  "name": "@tomato/experimental-tool-robot-crew",
  "description": "Model-facing robot_crew_create tool that orchestrates published Tomato Rbot agents into a crew from a conversation",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/experimental-tool-robot-crew"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/**/*.js.map",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot": "workspace:*",
    "@tomato/experimental-robot-crew": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*"
  }
}
