{
  "name": "@tomato/tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/terminal": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/terminal": "workspace:*",
    "@tomato/terminal-bash": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/jobs": "workspace:*",
    "@tomato/jobs-local": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-jobs": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/session-projection": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
}
