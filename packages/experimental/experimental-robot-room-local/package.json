{
  "name": "@tomato/experimental-robot-room-local",
  "description": "Storage-backed Robot Room provider: durable log, bounded wake scheduler, persistent member Sessions, and room tools",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/experimental-robot-room-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/**/*.js.map",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-default-model": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot-room": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/util-values": "workspace:*"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-default-model": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot-room": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/util-values": "workspace:*"
  }
}
