{
  "name": "@tomato/superagent-local",
  "description": "Runs one superagent ticket per in-process agent and reads the report its turn wrote",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/superagent-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/superagent": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/tools": "workspace:*"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-default-model": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/superagent": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/tools": "workspace:*"
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
