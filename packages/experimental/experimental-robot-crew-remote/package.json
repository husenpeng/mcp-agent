{
  "name": "@tomato/experimental-robot-crew-remote",
  "description": "Mounts the generated crew Remote contribution in an optional client assembly",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/experimental-robot-crew-remote"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/api-gateway": "workspace:*",
    "@tomato/api-robot-crew-controller": "workspace:*",
    "@tomato/client-connection": "workspace:*",
    "@tomato/cordis": "workspace:~"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-gateway",
        "@tomato/client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
