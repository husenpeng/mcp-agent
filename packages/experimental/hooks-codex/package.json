{
  "name": "@tomato/hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the Tomato Harness interception seams",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/hook-protocol": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/shell": "workspace:*",
    "@tomato/bash-local": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/hook-protocol": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/session-projection": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
}
