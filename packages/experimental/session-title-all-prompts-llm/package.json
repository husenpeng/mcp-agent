{
  "name": "@tomato/session-title-all-prompts-llm",
  "description": "All-user-messages LLM provider plugin for Tomato Harness session titles",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/session-title-all-prompts-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["locale/*.json", "lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-title": "workspace:*",
    "@tomato/session-title-llm": "workspace:*",
    "@tomato/cordis": "workspace:~"
  },
  "dependencies": {
    "@tomato/util-values": "workspace:*",
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-title": "workspace:*",
    "@tomato/session-title-llm": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/session-projection": "workspace:*",
    "@tomato/agent-loop": "workspace:*"
  }
}
