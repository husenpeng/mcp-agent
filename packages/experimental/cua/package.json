{
  "name": "@tomato/cua",
  "description": "Shared Computer Use application objects, authorization, and logged tool execution",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/remote-types.js"
    },
    "./native-client": {
      "types": "./lib/types/native-client.d.ts",
      "default": "./lib/native-client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/remote-types.js",
    "lib/api.js",
    "lib/bridge.js",
    "lib/native-client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/user-questions": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/scope": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@tomato/atomic-write": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "@tomato/computer-use": "workspace:*"
  },
  "devDependencies": {
    "@tomato/working-directory": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/attachment-local": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/ptc-runtime-node": "workspace:*",
    "@tomato/sandbox-local": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/user-questions": "workspace:*",
    "@tomato/app-boot": "workspace:*",
    "@tomato/config-editor": "workspace:*",
    "@tomato/hmr": "workspace:*",
    "@tomato/cordis-plugin-timer": "workspace:~",
    "@tomato/scope": "workspace:*",
    "@tomato/agent-preset-registry": "workspace:*",
    "@tomato/api-remotes": "workspace:*",
    "@tomato/api-gateway": "workspace:*",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/client-ui-plugin-manager": "workspace:*",
    "@tomato/client-ui-settings": "workspace:*",
    "@tomato/client-ui-layout": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.1.0",
    "@tomato/loader-smoke": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/client-ui-user-questions": "workspace:*",
    "@tomato/client-ui-approval": "workspace:*",
    "@tomato/client-ui-conversation": "workspace:*"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-remotes",
        "@tomato/client-locale",
        "@tomato/client-ui-plugin-manager",
        "@tomato/client-ui-settings",
        "@tomato/client-ui-layout",
        "@tomato/client-ui-user-questions",
        "@tomato/client-ui-approval",
        "@tomato/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
