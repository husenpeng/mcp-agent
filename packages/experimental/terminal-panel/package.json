{
  "name": "@tomato/terminal-panel",
  "description": "Persistent Agent terminals shown in the Web sidebar, plus read-only access to the user's terminals",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/terminal-panel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/api-terminal-controller": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/terminal": "workspace:*",
    "@tomato/tools": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/api-terminal-controller": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/output-retention": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/terminal": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
}
