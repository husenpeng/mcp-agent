{
  "name": "@tomato/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Tomato Harness Auto permission preset",
  "version": "0.2.1-rc.3",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-instructions": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/permission-presets": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tomato/util-values": "workspace:*"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/agent-instructions": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/bash-sandbox": "workspace:*",
    "@tomato/compaction": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/fs-observation-policy": "workspace:*",
    "@tomato/fs-sandbox": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/llm-deepseek-api-key": "workspace:*",
    "@tomato/permission-presets": "workspace:*",
    "@tomato/ptc-runtime-node": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/shell": "workspace:*",
    "@tomato/shell-env": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-bash": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-fs": "workspace:*",
    "@tomato/tool-subagent": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "tomato": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
