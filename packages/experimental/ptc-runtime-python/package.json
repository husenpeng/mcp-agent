{
  "name": "@tomato/experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the Tomato Harness PTC execution seam",
  "version": "0.2.1-rc.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "py/**/*.py",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/util-values": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/timeout": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/util-values": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/sandbox-local": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/session": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
}
