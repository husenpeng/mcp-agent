{
  "name": "@tomato/experimental-robot-local",
  "description": "Storage-backed robot specification registry, instantiation, and run control",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/robot-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/branded": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot": "workspace:*",
    "@tomato/permission-presets": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/util-values": "workspace:*"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tomato/branded": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot": "workspace:*",
    "@tomato/permission-presets": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/util-values": "workspace:*"
  }
}
