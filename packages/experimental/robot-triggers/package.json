{
  "name": "@tomato/experimental-robot-triggers",
  "description": "Starts robot runs from cron schedules and robot event topics",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/robot-triggers"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot": "workspace:*",
    "@tomato/schedule": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot": "workspace:*",
    "@tomato/schedule": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*"
  }
}
