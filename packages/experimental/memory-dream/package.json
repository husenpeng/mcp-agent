{
  "name": "@tomato/memory-dream",
  "description": "Offline memory consolidation (dreaming): collect a session window, backfill missing summaries, integrate across sessions, and curate the injection layer over ctx.memory",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/memory-dream"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/**/*.js.map",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-memory": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-query": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/timeout": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tomato/agent": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/experimental-memory": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-query": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/timeout": "workspace:*"
  }
}
