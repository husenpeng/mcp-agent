{
  "name": "@tomato/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/browser-use": "workspace:*",
    "@tomato/mcp-client": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/browser-use": "workspace:*",
    "@tomato/mcp-client": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/mcp-resources": "workspace:*",
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/attachment-local": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/working-directory": "workspace:*",
    "@tomato/fs-local": "workspace:*"
  }
}
