{
  "name": "@tomato/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "native/Package.swift",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/computer-use": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/agent": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@tomato/atomic-write": "workspace:*",
    "@tomato/cua": "workspace:*"
  },
  "devDependencies": {
    "@tomato/working-directory": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-include": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/attachment-local": "workspace:*",
    "@tomato/computer-use": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/tool-executor-native": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/llm-deepseek": "workspace:*",
    "@tomato/ptc-runtime-node": "workspace:*",
    "@tomato/sandbox-local": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@tomato/ptc-runtime": "workspace:*",
    "@tomato/user-questions": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/app-boot": "workspace:*",
    "@tomato/config-editor": "workspace:*",
    "@tomato/hmr": "workspace:*",
    "@tomato/cordis-plugin-timer": "workspace:~"
  },
  "scripts": {
    "build:native": "swift build --package-path native --configuration release"
  },
  "os": [
    "darwin"
  ]
}
