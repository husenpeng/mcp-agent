{
  "name": "@tomato/experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~",
    "@tomato/timeout": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/session-projection-cache": "workspace:*",
    "@tomato/session-query": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/working-directory": "workspace:*",
    "@tomato/workspace": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/fs": "workspace:*",
    "@tomato/fs-local": "workspace:*",
    "@tomato/sandbox": "workspace:*",
    "@tomato/sandbox-local": "workspace:*",
    "@tomato/sandbox-policy": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/session-projection-cache": "workspace:*",
    "@tomato/session-query": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/storage": "workspace:*",
    "@tomato/storage-domain": "workspace:*",
    "@tomato/subprocess": "workspace:*",
    "@tomato/subprocess-local": "workspace:*",
    "@tomato/system-prompt": "workspace:*",
    "@tomato/working-directory": "workspace:*",
    "@tomato/workspace": "workspace:*"
  }
}
