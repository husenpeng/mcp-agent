{
  "name": "@tomato/experimental-embeddings-http",
  "description": "OpenAI-compatible embeddings provider for ctx.embeddings over one batched HTTP request",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/embeddings-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/credentials": "workspace:*",
    "@tomato/experimental-embeddings": "workspace:*",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/cosmokit": "workspace:~",
    "@tomato/credentials": "workspace:*",
    "@tomato/credentials-local": "workspace:*",
    "@tomato/experimental-embeddings": "workspace:*",
    "@tomato/launch-environment": "workspace:*",
    "@tomato/schemastery": "workspace:~",
    "@tomato/settings": "workspace:*"
  }
}
