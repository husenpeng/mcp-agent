{
  "name": "@tomato/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Tomato Harness SDK clients",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tomato/branded": "workspace:*",
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek-api-key": "workspace:*",
    "@tomato/schedule": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/sdk-protocol": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/user-questions": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/cordis-plugin-loader": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/agent-loop": "workspace:*",
    "@tomato/agent-loop-testkit": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-deepseek-api-key": "workspace:*",
    "@tomato/schedule": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/sdk-protocol": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-persistence-jsonl": "workspace:*",
    "@tomato/session-projection": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/user-approval": "workspace:*",
    "@tomato/user-questions": "workspace:*",
    "@tomato/working-directory": "workspace:*"
  }
}
