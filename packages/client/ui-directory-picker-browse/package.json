{
  "name": "@tomato/client-ui-directory-picker-browse",
  "description": "In-app directory browsing surface: the workspace directory-flow owner rendering the host's listing and creation primitives",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-directory-picker-browse"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-remotes",
        "@tomato/client-ui-renderer",
        "@tomato/client-ui-workspace",
        "@tomato/client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/api-remotes": "workspace:*",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/client-ui-workspace": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@tomato/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "clsx": "^2.0.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
