{
  "name": "@tomato/client-ui-entry-customization",
  "version": "0.2.1-rc.3",
  "description": "Customize plugin entries in the left sidebar, conversation views, and right sidebar, and quickly create new plugins.",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-entry-customization"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["locale/*.json", "lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": { "@tomato/cordis": "workspace:~" },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-product-analytics": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-ui-sidebar": "workspace:*",
    "@tomato/client-ui-conversation": "workspace:*",
    "@tomato/client-ui-sidebar-right": "workspace:*",
    "@tomato/client-ui-plugin-manager": "workspace:*",
    "@tomato/client-ui-workspace": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^19.3.0",
    "@testing-library/react": "^16.3.3"
  },
  "tomato": {
    "client": {
      "platform": "web",
      "inject": [
        "@tomato/client-locale",
        "@tomato/client-ui-plugin-manager",
        "@tomato/client-ui-workspace"
      ]
    }
  },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" }
}
