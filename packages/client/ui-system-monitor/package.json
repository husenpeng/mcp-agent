{
  "name": "@tomato/client-ui-system-monitor",
  "description": "Floating system monitor overlay: processor, graphics, memory, network, disk, power, and process readings from the Host",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-system-monitor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-system-monitor-controller",
        "@tomato/client-locale",
        "@tomato/client-ui-layout",
        "@tomato/client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@tomato/api-system-monitor-controller": "workspace:*",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "@tomato/client-ui-layout": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^19.3.1"
  }
}
