{
  "name": "@tomato/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-session-controller",
        "@tomato/client-file-upload",
        "@tomato/client-locale",
        "@tomato/client-ui-layout",
        "@tomato/client-ui-renderer",
        "@tomato/client-ui-session",
        "@tomato/client-ui-settings",
        "@tomato/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/api-remotes": "workspace:*",
    "@tomato/api-session-controller": "workspace:*",
    "@tomato/api-workspace-controller": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-file-upload": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "@tomato/client-ui-layout": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-session": "workspace:*",
    "@tomato/client-ui-settings": "workspace:*",
    "@tomato/client-ui-workspace": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/goal": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-retry": "workspace:*",
    "@tomato/plan-mode": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tomato/token-meter": "workspace:*",
    "@tomato/tool-todo": "workspace:*",
    "@tomato/util-crypto": "workspace:*",
    "@tomato/workspace": "workspace:*",
    "@tomato/file-reference": "workspace:*",
    "@tomato/util-workspace-path": "workspace:*",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "zod": "4.4.3",
    "lexical": "^0.51.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@tomato/agent": "workspace:*",
    "@tomato/settings": "workspace:*",
    "@tomato/client-shortcuts": "workspace:*",
    "@tomato/client-product-analytics": "workspace:*",
    "@tomato/message-quotes": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
