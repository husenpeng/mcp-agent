{
  "name": "@tomato/client-ui-image-evidence",
  "description": "Evidence card beside each pasted image: which vision engine read it, how long it took, and whether the read failed or was truncated",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-image-evidence"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/client-locale",
        "@tomato/client-ui-chat",
        "@tomato/client-ui-renderer",
        "@tomato/client-ui-session",
        "@tomato/image-evidence"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "@tomato/client-ui-chat": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-session": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/image-evidence": "workspace:*",
    "@tomato/session": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
