{
  "name": "@tomato/client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./assets/*": "./lib/assets/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-session-controller",
        "@tomato/api-workspace-controller",
        "@tomato/client-connection",
        "@tomato/client-locale",
        "@tomato/client-ui-conversation",
        "@tomato/client-ui-input-trigger",
        "@tomato/client-ui-layout",
        "@tomato/client-ui-renderer",
        "@tomato/client-ui-session",
        "@tomato/client-ui-settings",
        "@tomato/client-ui-sidebar-right",
        "@tomato/client-ui-workspace",
        "@tomato/client-ui-file-drag"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/api-remotes": "workspace:*",
    "@tomato/api-session-controller": "workspace:*",
    "@tomato/api-workspace-controller": "workspace:*",
    "@tomato/api-workspace-files": "workspace:*",
    "@tomato/attachment": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/client-connection": "workspace:*",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-ui-approval": "workspace:*",
    "@tomato/client-ui-conversation": "workspace:*",
    "@tomato/client-ui-input-trigger": "workspace:*",
    "@tomato/client-ui-layout": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-session": "workspace:*",
    "@tomato/client-ui-settings": "workspace:*",
    "@tomato/client-ui-sidebar-browser": "workspace:*",
    "@tomato/client-ui-sidebar-documentpreview": "workspace:*",
    "@tomato/client-ui-sidebar-right": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/client-ui-workspace": "workspace:*",
    "@tomato/commands": "workspace:*",
    "@tomato/compaction": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/llm-retry": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/session-stats": "workspace:*",
    "@tomato/session-turn-outline": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/token-meter": "workspace:*",
    "@tomato/util-workspace-path": "workspace:*",
    "@tomato/tool-executor-ptc": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "react": "^18.2.0",
    "react-dom": "^19.3.0",
    "@tomato/settings": "workspace:*",
    "@tomato/client-product-analytics": "workspace:*",
    "@tomato/client-ui-file-drag": "workspace:*"
  },
  "dependencies": {
    "@tomato/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "lib/types/**/*.d.ts"
  ]
}
