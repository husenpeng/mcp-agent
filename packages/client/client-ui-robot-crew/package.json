{
  "name": "@tomato/client-ui-robot-crew",
  "description": "Tomato Rbot crew studio: a multi-agent workflow canvas, node inspector, loop-guard settings, and live flow ledger",
  "version": "0.2.1-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/client-ui-robot-crew"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tomato/api-robot-controller": "workspace:*",
    "@tomato/api-robot-crew-controller": "workspace:*",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-ui-layout": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-sidebar": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/client-ui-workspace": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot-crew": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-robot-controller",
        "@tomato/api-robot-crew-controller",
        "@tomato/client-locale",
        "@tomato/client-ui-layout",
        "@tomato/client-ui-primitives",
        "@tomato/client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
