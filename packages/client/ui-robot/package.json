{
  "name": "@tomato/client-ui-robot",
  "description": "Tomato Rbot page: the robot roster in the sidebar, the guided creation flow, the robot specification editor, and a robot conversation surface separate from workspaces",
  "version": "0.2.1-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-robot"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tomato/cordis": "workspace:~"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@tomato/api-remote-access": "workspace:*",
    "@tomato/api-remotes": "workspace:*",
    "@tomato/api-robot-controller": "workspace:*",
    "@tomato/api-session-controller": "workspace:*",
    "@tomato/branded": "workspace:*",
    "@tomato/client-locale": "workspace:*",
    "@tomato/client-store": "workspace:*",
    "@tomato/client-test-runtime": "workspace:*",
    "@tomato/client-ui-chat": "workspace:*",
    "@tomato/client-ui-conversation": "workspace:*",
    "@tomato/client-ui-layout": "workspace:*",
    "@tomato/client-ui-primitives": "workspace:*",
    "@tomato/client-ui-renderer": "workspace:*",
    "@tomato/client-ui-session": "workspace:*",
    "@tomato/client-ui-sidebar": "workspace:*",
    "@tomato/client-ui-slots": "workspace:*",
    "@tomato/client-ui-tool": "workspace:*",
    "@tomato/client-ui-workspace": "workspace:*",
    "@tomato/cordis": "workspace:~",
    "@tomato/experimental-robot": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/typert-protocol": "workspace:*",
    "@tomato/util-values": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "locale/*.json"
  ],
  "tomato": {
    "client": {
      "inject": [
        "@tomato/api-robot-controller",
        "@tomato/api-session-controller",
        "@tomato/client-locale",
        "@tomato/client-ui-conversation",
        "@tomato/client-ui-layout",
        "@tomato/client-ui-workspace",
        "@tomato/client-ui-primitives",
        "@tomato/client-ui-session",
        "@tomato/client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
