{
  "name": "@tomato/tool-schedule",
  "description": "Model-facing reminder management tools (schedule_create, schedule_list, schedule_update, schedule_delete) over the Host ctx.schedule service",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/schedule/tool-schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/llm": "workspace:*",
    "@tomato/schedule": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/tools": "workspace:*"
  },
  "devDependencies": {
    "@tomato/cordis": "workspace:~",
    "@tomato/agent": "workspace:*",
    "@tomato/llm": "workspace:*",
    "@tomato/schedule": "workspace:*",
    "@tomato/scope": "workspace:*",
    "@tomato/session": "workspace:*",
    "@tomato/subagent": "workspace:*",
    "@tomato/tool-testkit": "workspace:*",
    "@tomato/tools": "workspace:*"
  }
}
