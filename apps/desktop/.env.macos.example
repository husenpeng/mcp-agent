# Default macOS packaging environment, read when no --preset selects a platform file.
# The per-command templates under config/macos-packaging/ (test.env, production.env)
# are preferred; this file remains for the legacy .env.macos workflow.
# Shell-exported values win over this file. Signing credentials may live here for
# the legacy workflow, or in config/macos-packaging/secrets/macos-signing.env.
TOMATO_DESKTOP_APP_ID=vip.tomatoai.desktop
TOMATO_DESKTOP_AUTO_UPDATE_ENV=test
TOMATO_DESKTOP_NPM_REGISTRY=
TOMATO_DESKTOP_AUTH_SERVICE_URL=http://localhost:8020
TOMATO_DESKTOP_TOMATO_WEB_URL=http://localhost:3000
TOMATO_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
TOMATO_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
TOMATO_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=
TOMATO_DESKTOP_MACOS_PACK_CONCURRENCY=4
TOMATO_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
TOMATO_DESKTOP_MACOS_DOWNLOAD_PROXY=
TOMATO_DESKTOP_MACOS_NOTARIZATION_PROXY=
# TOMATO_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
# Configure exactly one notarization strategy; API key is the default.
TOMATO_DESKTOP_MACOS_SIGNING_IDENTITY=
TOMATO_DESKTOP_MACOS_TEAM_ID=
CSC_LINK=./certificates/developer-id.p12
CSC_KEY_PASSWORD=
APPLE_API_KEY=./certificates/notarization.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# APPLE_KEYCHAIN_PROFILE=
# APPLE_KEYCHAIN=
