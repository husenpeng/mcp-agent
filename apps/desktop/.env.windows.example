# Default Windows packaging environment, read when no --preset selects a platform file.
# The per-command templates under config/windows-packaging/ (test.env, production.env)
# are preferred; this file remains for the legacy .env.windows workflow.
# Shell-exported values win over this file. Signing credentials may live here for
# the legacy workflow, or in config/windows-packaging/secrets/windows-signing.env.
TOMATO_DESKTOP_APP_ID=vip.tomatoai.desktop
TOMATO_DESKTOP_AUTO_UPDATE_ENV=test
TOMATO_DESKTOP_NPM_REGISTRY=
TOMATO_DESKTOP_AUTH_SERVICE_URL=
TOMATO_DESKTOP_TOMATO_WEB_URL=
TOMATO_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
TOMATO_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
TOMATO_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=
# TOMATO_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
TOMATO_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
TOMATO_DESKTOP_WINDOWS_PACK_CONCURRENCY=4
TOMATO_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
TOMATO_DESKTOP_WINDOWS_CER_FILE=./certificates/windows.cer
TOMATO_DESKTOP_WINDOWS_SIGNTOOL=
TOMATO_DESKTOP_WINDOWS_KEY_CONTAINER=
TOMATO_DESKTOP_WINDOWS_TOKEN_PIN=
