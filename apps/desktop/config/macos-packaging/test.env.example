# Process-only inputs for this command (not file settings):
#   --preset test                  selects this file; --build-version sets the artifact version
#   PACKAGE_MACOS_ZIP_COMPRESSION_LEVEL  3 or 7 workflow override
#   TOMATO_DESKTOP_PACKAGE_CACHE_DIR     shared downloads and pnpm-store cache
#   TOMATO_DESKTOP_UPDATE_CHANNEL        nightly (default) or latest
# Copy to test.env in apps/desktop/config/macos-packaging, or into a machine
# configuration's presets/ directory selected by TOMATO_PACKAGING_CONFIG_DIR.
# The packaging command reads this file as defaults; shell-exported values win.
# Signing credentials belong in secrets/macos-signing.env, not here.
TOMATO_DESKTOP_APP_ID=vip.tomatoai.desktop
TOMATO_DESKTOP_AUTO_UPDATE_ENV=test
TOMATO_DESKTOP_NPM_REGISTRY=

# Login services sealed into every artifact built from this preset.
TOMATO_DESKTOP_AUTH_SERVICE_URL=http://localhost:8020
TOMATO_DESKTOP_TOMATO_WEB_URL=http://localhost:3000

# Mandatory-update policy for the test deployment.
TOMATO_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
# Accepted by the preset schema; unused while AUTO_UPDATE_ENV=test.
TOMATO_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
TOMATO_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

# Test download channel; generate a 32-character lowercase hexadecimal release ID.
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=

# macOS packaging.
TOMATO_DESKTOP_MACOS_PACK_CONCURRENCY=4
TOMATO_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
TOMATO_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Temporarily changes the active network service's system HTTP/HTTPS proxies.
TOMATO_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets.
# TOMATO_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
