# Copy to secrets/macos-signing.env with mode 0600; keep this directory outside the runner checkout.
# Login service origins belong in the preset env file; this file accepts signing credentials only.
TOMATO_DESKTOP_MACOS_SIGNING_IDENTITY=
TOMATO_DESKTOP_MACOS_TEAM_ID=
CSC_LINK=../certificates/developer-id.p12
CSC_KEY_PASSWORD=
# Configure exactly one notarization strategy. Uncomment only the strategy this
# machine uses; a defined value from any other strategy fails validation.
# Strategy 1: App Store Connect API key.
APPLE_API_KEY=../certificates/notarization.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Strategy 2: Apple ID with an app-specific password.
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# Strategy 3: notarytool keychain profile.
# APPLE_KEYCHAIN_PROFILE=
# APPLE_KEYCHAIN=
