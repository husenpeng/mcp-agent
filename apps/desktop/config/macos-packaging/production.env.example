# Copy to production.env and configure the production service before selecting this preset.
TOMATO_DESKTOP_APP_ID=com.deepseek.dsh
TOMATO_DESKTOP_AUTO_UPDATE_ENV=production
# Login services sealed into every artifact built from this preset.
TOMATO_DESKTOP_AUTH_SERVICE_URL=http://localhost:8020
TOMATO_DESKTOP_TOMATO_WEB_URL=http://localhost:3000
TOMATO_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
TOMATO_DESKTOP_MACOS_PACK_CONCURRENCY=4
TOMATO_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
TOMATO_DESKTOP_MACOS_DOWNLOAD_PROXY=
TOMATO_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# TOMATO_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
