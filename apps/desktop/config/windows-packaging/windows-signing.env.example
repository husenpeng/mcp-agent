# Copy to windows-signing.env in the same machine configuration directory and fill in the values.
# Login service origins belong in the preset env file; this file accepts signing credentials only.
# Restrict this file to the runner account, SYSTEM and administrators.
# File paths resolve relative to this file; use the same account as local signing.
TOMATO_DESKTOP_WINDOWS_CER_FILE=../certificates/windows.cer
TOMATO_DESKTOP_WINDOWS_SIGNTOOL=
TOMATO_DESKTOP_WINDOWS_KEY_CONTAINER=
TOMATO_DESKTOP_WINDOWS_TOKEN_PIN=
