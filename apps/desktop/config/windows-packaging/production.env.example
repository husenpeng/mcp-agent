# Process-only inputs for this command (not file settings):
#   --preset production            selects this file; --build-version sets the artifact version
#   PACKAGE_WINDOWS_COMPRESSION_LEVEL  3 or 7 workflow override
#   TOMATO_DESKTOP_PACKAGE_CACHE_DIR   shared downloads and pnpm-store cache
#   TOMATO_DESKTOP_UPDATE_CHANNEL      nightly (default) or latest
# Copy to production.env in apps/desktop/config/windows-packaging, or into a machine
# configuration's presets/ directory selected by TOMATO_PACKAGING_CONFIG_DIR.
# The packaging command reads this file as defaults; shell-exported values win.
# Signing credentials belong in secrets/windows-signing.env, not here.
TOMATO_DESKTOP_APP_ID=vip.tomatoai.desktop
TOMATO_DESKTOP_AUTO_UPDATE_ENV=production
TOMATO_DESKTOP_NPM_REGISTRY=

# Login services sealed into every artifact built from this preset.
TOMATO_DESKTOP_AUTH_SERVICE_URL=
TOMATO_DESKTOP_TOMATO_WEB_URL=

# Mandatory-update policy for the production deployment.
TOMATO_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
# Accepted by the preset schema; unused while AUTO_UPDATE_ENV=production.
TOMATO_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
# Production policy rejects allowedAuthOrigins; keep an empty options object.
TOMATO_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'

# Accepted by the preset schema; the production deployment does not use the test channel.
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=

# Windows packaging.
# Optional absolute private cache directory; omit to retain the account default cache.
# TOMATO_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
TOMATO_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
TOMATO_DESKTOP_WINDOWS_PACK_CONCURRENCY=4
# Installer archive compression (0-9).
TOMATO_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
