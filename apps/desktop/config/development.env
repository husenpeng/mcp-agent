# Development command defaults for `pnpm run dev:desktop` / `start:desktop`.
# Values exported by the launching shell win; this file only fills names the shell leaves unset.
# An empty value means "use the launcher's development default", not an empty override.
# Login services sealed into every artifact built from this preset, and into
# unsigned macOS dmg builds (their only source of packaged login origins).
TOMATO_DESKTOP_AUTH_SERVICE_URL=http://14.103.39.34:8003
TOMATO_DESKTOP_TOMATO_WEB_URL=https://test.tomatoai.vip

# Disposable development state; empty keeps apps/desktop/.desktop-build/development.
TOMATO_HOME=
TOMATO_DESKTOP_USER_DATA_DIR=
TOMATO_DESKTOP_PRIMARY_RUNTIME_DIR=

# Attached debuggers and Electron logging.
TOMATO_DESKTOP_MAIN_INSPECT_PORT=9229
TOMATO_DESKTOP_RENDERER_DEBUG_PORT=9222
TOMATO_DESKTOP_HOST_INSPECT_PORT=9230
TOMATO_DESKTOP_OPEN_DEVTOOLS=1
ELECTRON_ENABLE_LOGGING=1
TOMATO_DESKTOP_LOGIN_SHELL_TIMEOUT_MS=

# Optional overrides for the prepared runtime and bundled CLI.
TOMATO_DESKTOP_NPM_REGISTRY=
TOMATO_DESKTOP_BUNDLE_DIR=
TOMATO_DESKTOP_PNPM_ENTRY=
TOMATO_DESKTOP_DIAGNOSTIC_FILE=
